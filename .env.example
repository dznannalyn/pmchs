# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Replace placeholders with your Atlas database user and a rotated password.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.wzxdtwe.mongodb.net/quiz-importer?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret (Change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL
FRONTEND_URL=http://localhost:3000


# Optional: enables Gemini inference for ambiguous questions only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_TEMP_DIR=./uploads/temp
